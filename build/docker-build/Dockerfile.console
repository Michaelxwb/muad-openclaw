# muad-console 镜像 Dockerfile（千流 CI 拼装版）
#
# 设计：前端 dist 和后端二进制由前置 task 构建并上传制品库，
#      本 Dockerfile 只负责"拼装"——COPY 制品进 platos-kylin 基础镜像。
#      不做多 stage 构建，构建机只需 docker，不需要 node/go 环境。
#
# 千流 Task3 (docker:latest 镜像) 执行步骤：
#   1. sfspm download <repo>/<backend-bin-pkg>/<ver>   → muad-console-bin.tar.gz
#   2. tar -xzf muad-console-bin.tar.gz -C build/docker-build/  → build/docker-build/muad-console
#   3. docker build -t docker.sangfor.com/mss-release/muad-console:<ver> \
#         -f build/docker-build/Dockerfile.console build/docker-build/
#
# 说明：前端 dist 在 Task2 后端构建时已通过 go:embed 编入二进制，
#      拼装镜像时只需 COPY 二进制本身，无需单独 COPY dist。
#
# 运行时：内网采用 runtime.driver=k8s，经 client-go 调 K8s API 建 worker，
#         不依赖 docker.sock，无需 docker-cli（安全性更高、镜像更小）。
#
# 构建上下文：build/docker-build/，需包含：
#   - muad-console        (后端二进制，CGO_ENABLED=0 静态产物，已内嵌前端 dist)
#
# 注：platos-kylin 基础镜像自带 ca-certificates 和 tzdata，无需额外安装。
#     之前用 yum install 是误写（platos-kylin 不是 yum 系），导致 docker build 失败。

FROM docker.sangfor.com/mss-base/platos-kylin:1.3

# sqlite3 CLI（排障用，kubectl exec 进 Pod 操作业务库）。
# 为什么走 COPY 二进制而不是包管理器装：
#   - platos-kylin:1.3 镜像把 dnf/yum 二进制全裁了，只剩 rpm 工具链，无法 RUN dnf install。
#   - 构建机无外网，不能 RUN curl 下载。
#   - 所以由构建前置步骤把 sqlite3 二进制放进 build context，这里只 COPY。
# 版本：musl 静态编译（sqlite amalgamation），statically linked、零 glibc 依赖，
#   任意 Linux 可跑（PlatOS/xaasos 均兼容），编译时已 strip（约 1.4MB）。
#   勿换回 sqlite.org 官方 8.6MB 动态版——它需要 GLIBC_2.34，PlatOS(2.28) 会报
#   GLIBC_2.29/2.33/2.34 not found。
COPY sqlite3 /usr/local/bin/sqlite3
RUN chmod 0755 /usr/local/bin/sqlite3 && strip /usr/local/bin/sqlite3 || true

COPY muad-console /usr/local/bin/muad-console
ENV TZ=Asia/Shanghai
VOLUME /var/lib/muad-console
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/muad-console"]