# ⚠️ 已废弃：本模板属于旧版手动开通流（provision-user.sh），worker 镜像要求
# Console 下发的 Runtime DTO，请改用 Console 的 Pod 管理开通用户。
# 用法：cp users/_template.config users/<userId>/config && 编辑 && ./provision-user.sh <userId>
# 含密钥，权限自动设 600，勿提交 git。

# 企微智能机器人（每用户独立 bot）
WECOM_BOT_ID=
WECOM_SECRET=

# 注：LLM_* 已移除——pod 侧无消费者，模型只能经 Console 的模型池（Runtime DTO
# providers，apiKey 加密存储）下发，环境变量配置不会生效。
