{
  "id": "session-manager",
  "name": "Session Manager",
  "description": "Provides isolated business-platform session state for the active agent.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "session_get_state"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "consoleInternalURL": {
        "type": "string"
      },
      "agentProfiles": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentId", "profile"],
          "properties": {
            "agentId": { "type": "string" },
            "profile": { "type": "string" }
          }
        }
      }
    }
  }
}
