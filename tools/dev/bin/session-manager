#!/usr/bin/env python3
"""Local-development stand-in for `session-manager`.

The skill SDK executes `session-manager get-state --skill-name <name>` and
expects stdout ``{"sessionStateFile": "..."}``. This shim skips Console and
returns the state file configured by ``MUAD_LOCAL_SESSION_STATE`` (or an
explicit ``--file <path>`` argument). Put ``tools/dev/bin`` first on PATH.

Repository dev tooling only; this file is not installed into the app image.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path


def fail(code: str, message: str, exit_code: int) -> None:
    sys.stderr.write(json.dumps({"error": {"code": code, "message": message}}) + "\n")
    raise SystemExit(exit_code)


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] == "--version":
        print(json.dumps({"version": "local-shim"}))
        return 0
    file_arg = ""
    if "--file" in args:
        index = args.index("--file")
        file_arg = args[index + 1] if index + 1 < len(args) else ""
    raw = (file_arg or os.environ.get("MUAD_LOCAL_SESSION_STATE", "")).strip()
    if not raw:
        fail("invalid_context", "MUAD_LOCAL_SESSION_STATE is not set", 3)
    state = Path(raw).expanduser().resolve()
    if not state.is_file():
        fail("invalid_arguments", "local session state file not found: %s" % state, 2)
    try:
        json.loads(state.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        fail("invalid_arguments", "local session state file is unreadable: %s" % error, 2)
    print(json.dumps({"sessionStateFile": str(state)}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
