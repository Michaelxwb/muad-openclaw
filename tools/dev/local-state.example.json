{
  "_comment": "Local-development session state for `session-manager get-state --file`. Replace every value with a real platform session. Cookies and CSRF values must never be committed.",
  "version": 1,
  "agentId": "local-agent",
  "skillName": "my-skill",
  "humanUserId": "local-user",
  "podId": "local-pod",
  "platforms": {
    "mssw": {
      "platform": "mssw",
      "source": "refresh",
      "expiresAt": "2026-12-31T00:00:00Z",
      "credentialFingerprint": "sha256:local-file",
      "cookies": [
        {
          "name": "session",
          "value": "<REAL_COOKIE_VALUE>",
          "domain": "mssw.example.internal",
          "path": "/"
        }
      ],
      "storageState": {
        "cookies": [
          {
            "name": "session",
            "value": "<REAL_COOKIE_VALUE>",
            "domain": "mssw.example.internal",
            "path": "/"
          }
        ],
        "origins": []
      },
      "requestProfile": {
        "baseUrl": "https://mssw.example.internal",
        "hostHeader": {
          "Host": "mssw.example.internal"
        },
        "csrf": [
          {
            "cookie": "csrf_token",
            "header": "x-csrftoken"
          }
        ],
        "staticHeaders": {},
        "traceHeader": "Traceid",
        "extraAllowed": true
      }
    }
  }
}
