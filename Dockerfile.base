# muad-openclaw 基础镜像
# 包含：上游 OpenClaw + Chromium/Playwright + 企微/微信/Mattermost 插件 + 系统依赖 + 基线种子
# 变更频率：按季度 / 上游发版 / Chromium 升级 / 通道插件更新
ARG OPENCLAW_VERSION=2026.7.1

FROM ghcr.io/openclaw/openclaw:${OPENCLAW_VERSION}

ARG OPENCLAW_VERSION
# 本地构建可指定国内 apt 镜像源（如 https://mirrors.aliyun.com）避开 deb.debian.org CDN 超时；
# 默认空 = 官方源，GitHub Actions 构建行为不变。
ARG APT_MIRROR
# 本地构建可指定 Playwright 浏览器下载镜像（如 https://npmmirror.com/mirrors/playwright）
# 避开 playwright 官方 CDN 超时；默认空 = 官方源，GitHub Actions 构建行为不变。
ARG PLAYWRIGHT_DOWNLOAD_HOST
LABEL org.opencontainers.image.base.name="ghcr.io/openclaw/openclaw:${OPENCLAW_VERSION}" \
      io.muad.openclaw.version="${OPENCLAW_VERSION}" \
      io.muad.image.role="base"

USER root
ENV OPENCLAW_STATE_DIR=/home/node/.openclaw \
    PLAYWRIGHT_BROWSERS_PATH=/home/node/.cache/ms-playwright

# 企微官方长连接插件版本
ARG WECOM_PLUGIN_VERSION=2026.6.23
# 微信（个人）通道插件
ARG WECHAT_PLUGIN_VERSION=2.4.3
# Mattermost 通道插件
ARG MATTERMOST_PLUGIN_VERSION=2026.7.1

COPY baseline-config.json /opt/muad/baseline-config.json
COPY bin/seed-config.mjs  /opt/muad/seed-config.mjs

# 安装系统依赖 + 浏览器 + 通道插件 + 生成基线种子
# （python3-pip 是系统包，基础镜像很少变；业务 Python 依赖走 app 镜像的 requirements.txt）
RUN set -eux; \
    if [ -n "${APT_MIRROR}" ]; then sed -i "s|http://deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; fi; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends unzip zip xvfb python3-pip; \
    mkdir -p "$PLAYWRIGHT_BROWSERS_PATH"; \
    if [ -n "${PLAYWRIGHT_DOWNLOAD_HOST}" ]; then export PLAYWRIGHT_DOWNLOAD_HOST; fi; \
    node /app/node_modules/playwright-core/cli.js install --with-deps chromium; \
    rm -rf /var/lib/apt/lists/*; \
    # 生成基线配置（构建期网关未起，setup 会非零退出但 openclaw.json 已写好）
    su node -c "openclaw setup --non-interactive --accept-risk --mode local" || true; \
    test -f /home/node/.openclaw/openclaw.json || { echo "FATAL: setup 未生成 openclaw.json" >&2; exit 1; }; \
    # 安装通道插件
    su node -c "openclaw plugins install '@wecom/wecom-openclaw-plugin@${WECOM_PLUGIN_VERSION}'"; \
    su node -c "openclaw plugins install '@tencent-weixin/openclaw-weixin@${WECHAT_PLUGIN_VERSION}'"; \
    su node -c "openclaw plugins install '@openclaw/mattermost@${MATTERMOST_PLUGIN_VERSION}'"; \
    # 基础通道插件是镜像能力，复制到不可变路径；PVC 只保存运行态数据
    install -d -m 0755 /opt/openclaw-plugins; \
    copy_image_plugin() { \
      package_path="$1"; target="$2"; \
      source="$(find /home/node/.openclaw/npm/projects -path "*/node_modules/${package_path}" -type d -print -quit)"; \
      test -n "$source"; \
      node_modules_dir="$(dirname "$(dirname "$source")")"; \
      cp -a "$source" "$target"; \
      install -d -m 0755 "$target/node_modules"; \
      cp -a "$node_modules_dir"/. "$target/node_modules"/; \
      rm -rf "$target/node_modules/${package_path}"; \
    }; \
    copy_image_plugin '@wecom/wecom-openclaw-plugin' /opt/openclaw-plugins/wecom-openclaw-plugin; \
    copy_image_plugin '@tencent-weixin/openclaw-weixin' /opt/openclaw-plugins/openclaw-weixin; \
    copy_image_plugin '@openclaw/mattermost' /opt/openclaw-plugins/mattermost; \
    # 合并基线配置 → 种子
    su node -c "node /opt/muad/seed-config.mjs"; \
    rm -rf /home/node/.openclaw/npm/projects; \
    cp -a /home/node/.openclaw /opt/openclaw-seed; \
    chown -R node:node /opt/openclaw-seed /opt/openclaw-plugins "$PLAYWRIGHT_BROWSERS_PATH" /home/node/.cache; \
    # 留一个空挂载点（PVC 首挂时按它初始化）
    rm -rf /home/node/.openclaw; \
    install -d -m 0700 -o node -g node /home/node/.openclaw

USER node
WORKDIR /app
